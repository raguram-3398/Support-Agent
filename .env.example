POSTGRES_USER=support_owner
POSTGRES_PASSWORD=local-owner-pw
POSTGRES_DB=support
SUPPORT_READ_PASSWORD=local-read-pw
SUPPORT_WRITE_PASSWORD=local-write-pw
SUPPORT_CHECKPOINT_PASSWORD=local-checkpoint-pw
DATABASE_URL_READ=postgresql+asyncpg://support_read:local-read-pw@127.0.0.1:5432/support
DATABASE_URL_WRITE=postgresql+asyncpg://support_write:local-write-pw@127.0.0.1:5432/support
CHECKPOINT_DB_URL=postgresql://support_checkpoint:local-checkpoint-pw@127.0.0.1:5432/checkpoints?connect_timeout=5&options=-c%20statement_timeout%3D5000
DATABASE_URL_ADMIN=postgresql+asyncpg://support_owner:local-owner-pw@127.0.0.1:5432/support
REDIS_URL=redis://127.0.0.1:6379/0
ANTHROPIC_API_KEY=replace-me
LANGFUSE_PUBLIC_KEY=replace-me
LANGFUSE_SECRET_KEY=replace-me
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-pw
AGENT_CLIENT_SECRET=local-agent-secret
ALICE_PASSWORD=local-alice-pw
BOB_PASSWORD=local-bob-pw
CAROL_PASSWORD=local-carol-pw
